{
  "name": "npm-installs",
  "displayName": "npm installs",
  "description": "npm installs",
  "version": "0.2.0",
  "publisher": "4mon",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amon222013/npm-installs"
  },
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "npm-installs.install-multi",
        "title": "npm-install-multi"
      },
      {
        "command": "npm-installs.install-single",
        "title": "npm-install-single"
      },
      {
        "command": "npm-installs.install-all",
        "title": "npm-install-all"
      }
    ],
    "configuration": {
      "title": "npm installs",
      "properties": {
        "npm-installs.concurrency": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum number of npm install processes run in parallel. 0 = auto (number of CPUs, up to 4)."
        },
        "npm-installs.cleanInstall": {
          "type": "boolean",
          "default": true,
          "description": "Delete node_modules and package-lock.json before npm install. Turn off to keep package-lock.json (faster)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test-unit": "npm run compile-tests && mocha --ui tdd --timeout 300000 out/test/unit/*.test.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  }
}
